#
# Copy these values into .env.local for local development.
# Never commit real secrets to the repository.
#

# Deployment mode:
# - local: full local SQLite-backed app
# - public: Neon-backed anonymous public app with rule-based planning
# - demo: emergency read-only fallback
LEVELYST_DEPLOY_MODE=local

# Optional for local OpenAI-backed planning only. Not needed for the hosted public rollout.
OPENAI_API_KEY=your_openai_api_key_here

# Planner provider:
# - rule_based: hosted public default and offline-safe local fallback
# - openai: optional local planner when you want to test API-backed planning
LEVELYST_PLANNER_PROVIDER=rule_based

# Default planner model. Override if you want to pin a different OpenAI model.
LEVELYST_OPENAI_MODEL=gpt-5-mini

# Number of planner retry attempts when the model returns invalid structured output.
LEVELYST_PLANNER_MAX_RETRIES=3

# Required for the hosted public app on Vercel.
DATABASE_URL=postgres://user:password@host/database
LEVELYST_KIOSK_SECRET=choose_a_long_random_secret

# Optional if you later want public prompt rate limiting on Vercel.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Optional local override for SQLite storage when LEVELYST_DEPLOY_MODE=local.
LEVELYST_DB_PATH=.levelyst/levelyst.sqlite

# Optional local Ollama wording layer for Grad Show demos.
OLLAMA_HOST=http://127.0.0.1:11434
LEVELYST_LOCAL_AI_MODE=copy_only
LEVELYST_LOCAL_AI_MODEL=qwen3:4b
LEVELYST_LOCAL_AI_TIMEOUT_MS=800
